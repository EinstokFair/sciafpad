--- a/gtk4/makefile
+++ b/gtk4/makefile
@@ -1,3 +1,5 @@
+PREFIX ?= /usr/local
+
 .PHONY: static shared all clean analyze depend gir doc
 
 .SUFFIXES: .cxx .c .o .h .a .list
@@ -54,10 +56,16 @@
 
-all: libscintilla.so
+all: shared
+
+libscintilla.so: $(COMPONENT)
+	ln -sf $(COMPONENT) $@
 
 static: $(COMPLIB)
 
 shared: $(COMPONENT)
 
+.PHONY: install
+install: shared
+	install -d "$(DESTDIR)$(PREFIX)/lib"
+	install -m 0755 "$(COMPONENT)" "$(DESTDIR)$(PREFIX)/lib/"
+	install -d "$(DESTDIR)$(PREFIX)/include/scintilla-gtk4"
+	install -m 0644 $(basedir)/include/*.h \
+		"$(DESTDIR)$(PREFIX)/include/scintilla-gtk4/"
+	install -m 0644 $(srcdir)/*.h \
+		"$(DESTDIR)$(PREFIX)/include/scintilla-gtk4/"
+
 # $(COMPONENT): $(VERSION_SCRIPT)
 
 demo: libscintilla.so
