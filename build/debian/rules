#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_configure:
	git clone https://github.com/bugaevc/scintilla.git debian/scintilla-bugaevc
	$(MAKE) -C debian/scintilla-bugaevc/gtk4 demo
	dh_auto_configure -- SCINTILLA_ROOT=$(CURDIR)/debian/scintilla-bugaevc

override_dh_auto_install:
	dh_auto_install
	mkdir -p debian/sciafpad/usr/lib/sciafpad
	cp debian/scintilla-bugaevc/bin/libscintilla.so \
	   debian/sciafpad/usr/lib/sciafpad/
